pipeline {
    agent any

    tools {
        maven 'M2_HOME' // Ensure 'M2_HOME' matches the Maven installation name in Jenkins
    }

    environment {
        SONARQUBE_USER = credentials('admin') // SonarQube username credential ID
        SONARQUBE_PASS = credentials('Aymenrahali@6631') // SonarQube password credential ID
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    git branch: 'aymen', url: 'https://github.com/Si-aymen/Courzello.git'
                }
            }
        }

        stage('Build') {
            steps {
                dir('backendPidev') {
                    sh 'mvn clean install -Dmaven.test.skip=true'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('backendPidev') {
                    // Running SonarQube scanner with secure credentials
                    script {
                        withSonarQubeEnv('sonar courZelo') { // Replace with your SonarQube server name
                            sh '''
                                mvn sonar:sonar \
                                -Dsonar.login=$SONARQUBE_USER \
                                -Dsonar.password=$SONARQUBE_PASS \
                                -Dmaven.test.skip=true
                            '''
                        }
                    }
                }
            }
        }

        stage('Test') {
            steps {
                dir('backendPidev') {
                    sh 'mvn test'
                }
            }
        }
    }

    post {
        success {
            echo 'Build, SonarQube analysis, and tests succeeded!'
        }
        failure {
            echo 'Build or analysis failed. Please check the logs.'
        }
    }
}
