pipeline {
    agent any

    tools {
        maven 'M2_HOME' // Make sure "M2_HOME" is configured in Jenkins under "Global Tool Configuration"
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    git branch: 'yosra', url: 'https://github.com/Si-aymen/Courzello.git'
                }
            }
        }

        stage('Build') {
            steps {
                dir('backendPidev') {
                    sh 'mvn clean install -Dmaven.test.skip=true'
                }
            }
        }

        stage('Test') {
            steps {
                dir('backendPidev') {
                    sh 'mvn test'
                }
            }
        }
    }

    post {
        success {
            echo 'Build and test stages completed successfully!'
            // You can add notification steps here if required (e.g., Slack, email)
        }
        failure {
            echo 'Build or test stages failed. Please check the logs.'
            // Optionally, add notification for failure
        }
    }
}
