pipeline {
    agent any

    tools {
        maven 'Maven 3' // Replace 'Maven 3' with the actual name of your Maven tool in Jenkins
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    git branch: 'yosra', url: 'https://github.com/Si-aymen/Courzello.git'
                }
            }
        }

        stage('Build') {
            steps {
                dir('backendPidev') {
                    sh 'mvn clean install -Dmaven.test.skip=true'
                }
            }
        }

        stage('Test') {
            steps {
                dir('backendPidev') {
                    sh 'mvn test' // Ensure this command is complete and correct
                }
            }
        }
    }

    post {
        success {
            echo 'Build and test stages completed successfully!'
            // Add notification steps here if needed (e.g., Slack, email)
        }
        failure {
            echo 'Build or test stages failed. Please check the logs.'
            // Optionally, add notification for failure
        }
        cleanup {
            echo '
