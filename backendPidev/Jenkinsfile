pipeline {
    agent any

    tools {
        maven 'M2_HOME' // Ensure 'M2_HOME' matches the Maven installation name in Jenkins
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    git branch: 'aymen', url: 'https://github.com/Si-aymen/Courzello.git'
                }
            }
        }

        stage('Build') {
            steps {
                dir('backendPidev') {
                    sh 'mvn clean install -Dmaven.test.skip=true'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('backendPidev') {
                    script {
                        withSonarQubeEnv('sonar courZelo') {
                            sh '''
                                mvn sonar:sonar \
                                -Dsonar.host.url=http://192.168.33.10:9000 \
                                -Dsonar.login=admin \
                                -Dsonar.password=Aymenrahali@6631 \
                                -Dmaven.test.skip=true
                            '''
                        }
                    }
                }
            }
        }

        stage('Test') {
            steps {
                dir('backendPidev') {
                    sh 'mvn test'
                }
            }
        }
    }

    post {
        success {
            echo 'Build, SonarQube analysis, and tests succeeded!'
        }
        failure {
            echo 'Build or analysis failed. Please check the logs.'
        }
    }
}
