pipeline {
    agent any

    tools {
        maven 'M2_HOME' // Ensure 'M2_HOME' matches the Maven installation name in Jenkins
    }

    stages {
        stage('Checkout') {
            steps {
                // Cloning the Git repository from the 'aymen' branch
                script {
                    git branch: 'aymen', url: 'https://github.com/Si-aymen/Courzello.git'
                }
            }
        }

        stage('Build') {
            steps {
                // Running the Maven build
                script {
                    sh 'mvn clean install'
                }
            }
        }

        stage('Test') {
            steps {
                // Running Maven tests
                script {
                    sh 'mvn test'
                }
            }
        }
    }

    post {
        success {
            echo 'Build and tests succeeded!'
        }
        failure {
            echo 'Build failed. Please check the logs.'
        }
    }
}
