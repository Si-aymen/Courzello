pipeline {
    agent any

    tools {
        maven 'M2_HOME' // Ensure 'M2_HOME' matches the Maven installation name in Jenkins
        sonar 'SonarQube Scanner' // Replace with the SonarQube Scanner name in Jenkins
    }

    environment {
        SONARQUBE_ENV = credentials('sonarqube-token') // Use your SonarQube token credentials ID
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    git branch: 'aymen', url: 'https://github.com/Si-aymen/Courzello.git'
                }
            }
        }

        stage('Build') {
            steps {
                dir('backendPidev') {
                    sh 'mvn clean install'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('backendPidev') {
                    // Running SonarQube scanner
                    script {
                        withSonarQubeEnv('SonarQube Server') { // Replace with your SonarQube server name
                            sh 'mvn sonar:sonar -Dsonar.login=admin -Dsonar.password=Aymenrahali@6631 -Dmaven.test.skip=true';
                        }
                    }
                }
            }
        }

        stage('Test') {
            steps {
                dir('backendPidev') {
                    sh 'mvn test'
                }
            }
        }
    }

    post {
        success {
            echo 'Build, SonarQube analysis, and tests succeeded!'
        }
        failure {
            echo 'Build or analysis failed. Please check the logs.'
        }
    }
}
