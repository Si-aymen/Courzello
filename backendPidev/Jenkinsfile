pipeline {
    agent any

    tools {
        maven 'M2_HOME' 
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    git branch: 'yosra', url: 'https://github.com/Si-aymen/Courzello.git'
                }
            }
        }

        stage('Build') {
            steps {
                dir('backendPidev') {
                    sh 'mvn clean install -Dmaven.test.skip=true'
                }
            }
        }


        stage('Test') {
            steps {
                dir('backendPidev') {
                    sh 'mvn test'
                }
            }
        }
    }

}
